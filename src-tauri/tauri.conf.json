{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenHUD",
  "version": "1.0.0",
  "identifier": "dev.tokenhud.hud",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hud",
        "title": "TokenHUD",
        "width": 76,
        "height": 244,
        "minWidth": 76,
        "minHeight": 120,
        "resizable": false,
        "focus": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "deb", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "AI CLI token-usage overlay",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
