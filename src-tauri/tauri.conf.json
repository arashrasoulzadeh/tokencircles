{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenHUD",
  "version": "0.1.0",
  "identifier": "dev.tokenhud.hud",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "hud",
        "title": "TokenHUD",
        "width": 268,
        "height": 172,
        "minWidth": 268,
        "minHeight": 172,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
